NODE_ENV=development

# Hono server
PORT=3000

# Supabase JS client (get from `supabase status` locally, or project settings in production)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite (browser-exposed — must match SUPABASE_URL and SUPABASE_ANON_KEY above)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# Drizzle direct Postgres connection (transaction-mode pooler in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production static asset directory (Railway sets cwd to repo root)
STATIC_DIR=./apps/web/dist
